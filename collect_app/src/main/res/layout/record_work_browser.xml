<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/remote_records_read_only"
        android:textAppearance="?attr/textAppearanceBody1" />

    <Button
        android:id="@+id/refresh_remote_records"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/remote_records_refresh" />

    <ProgressBar
        android:id="@+id/remote_records_progress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:visibility="gone" />

    <TextView
        android:id="@+id/remote_records_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="8dp"
        android:accessibilityLiveRegion="polite" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/protected_submission_queue"
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/remote_records_section"
                android:textStyle="bold"
                android:paddingTop="16dp" />

            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/remote_records_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="8dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/remote_work_section"
                android:textStyle="bold"
                android:paddingTop="16dp" />

            <LinearLayout
                android:orientation="vertical"
                android:id="@+id/remote_work_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="8dp" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
